{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Log Alert configuration schema",
  "type": "object",
  "required": ["log-fetchers", "alerters", "alerting-rules"],
  "properties": {
    "log-fetchers": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "config"],
        "properties": {
          "type": { "type": "string", "enum": ["file", "loki", "parseable"] },
          "config": { "type": "object" }
        }
      }
    },
    "alerters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["type", "config"],
        "properties": {
          "type": { "type": "string", "enum": ["log", "gotify"] },
          "config": { "type": "object" }
        }
      }
    },
    "alerting-rules": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["check-interval", "log-fetcher", "filters", "alerter"],
        "properties": {
          "check-interval": { "type": "number", "minimum": 0 },
          "log-fetcher": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            }
          },
          "filters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "config"],
              "properties": {
                "type": { "type": "string", "enum": ["geolocation", "regexp", "timestamp"] },
                "config": {
                  "type": "object"
                }
              }
            }
          },
          "alerter": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            }
          }
        }
      }
    }
  }
}